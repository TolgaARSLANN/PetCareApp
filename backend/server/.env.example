# Copy this file to .env and adjust the values.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pet_care_db

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Idle timeout: active sessions renew themselves; an unused one expires after this
JWT_EXPIRES_IN=1d
# Maximum session length after login (days)
# SESSION_MAX_DAYS=30

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:3000

# Set to "production" when deployed: the session cookie is then only sent over HTTPS
# NODE_ENV=production

# Rate limits per IP in a 15-minute window (defaults shown)
# AUTH_RATE_LIMIT=10     # failed login / register attempts
# API_RATE_LIMIT=1000    # all API requests

# Blog cover photos per user (defaults shown)
# PHOTO_UPLOADS_PER_HOUR=20
# PHOTO_STORAGE_MB=25
# Photo requests per IP in a 15-minute window
# IMAGE_RATE_LIMIT=600

# Number of reverse proxies in front of the API, so rate limits see the real client IP
# (0 when reached directly; 4 behind Vercel + Render, measured with /api/health)
# TRUST_PROXY=0

# Production only: secret the site's proxy (Vercel) sends with every API request; requests
# without it are refused. Leave unset in development.
# PROXY_SECRET=
